//cols of valid and max_cols of invalid matrix
function maxCols(array) {
    let max_cols = 0

    for (let i = 0; i < array.length; i++) {
        for (let j = 0; array[i][j] !== undefined; j++) {
            if (max_cols < j + 1) {
                max_cols = j + 1
            }
        }
    }
    return max_cols
}

