//matrix transpose
arr = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]

    // [1, 2, 3, 0, 1],
    // [4, 5, 6, 2, 3],
    // [7, 8, 9, 4, 5],
    // [6, 7, 1, 9, 0],
    // [1, 2, 3, 2, 2]

]

let tr_arr = []
let columns = maxCols(arr)

for (let i = 0; i < columns; i++) {
    tr_arr[i] = []
    for (let j = 0; j < arr.length; j++) {
        if (i === j) {
            tr_arr[i][j] = arr[i][j]
        }
        else if (i !== j) {
            tr_arr[i][j] = arr[j][i]
        }
    }
}

console.log("transposed", tr_arr);

